{
  "name": "Website History · Attio stage and company note",
  "nodes": [
    {
      "parameters": {},
      "id": "node-1",
      "name": "Run manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "setting-0",
              "name": "domain",
              "value": "example.com",
              "type": "string"
            },
            {
              "id": "setting-1",
              "name": "signals_base_url",
              "value": "http://localhost:8787",
              "type": "string"
            },
            {
              "id": "setting-2",
              "name": "apply_changes",
              "value": false,
              "type": "boolean"
            },
            {
              "id": "setting-3",
              "name": "stage_attribute",
              "value": "website_activity_state",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "node-2",
      "name": "Setup",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "if ($input.all().length !== 1) throw new Error('Run one company at a time; use a batch-size-one loop for lists.');\nconst c={...$input.first().json};\nif (typeof c.domain !== 'string') throw new Error('Enter a company domain.');\nc.domain=c.domain.trim().toLowerCase().replace(/^https?:\\/\\//,'').replace(/^www\\./,'').split('/')[0].replace(/\\.$/,'');\nif (!/^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?\\.[a-z]{2,}$/.test(c.domain)) throw new Error('Enter a public company domain.');\nif (typeof c.signals_base_url !== 'string' || !/^https?:\\/\\/[^\\s@?#]+$/.test(c.signals_base_url)) throw new Error('Enter the Signals service URL.');\nc.signals_base_url=c.signals_base_url.replace(/\\/+$/,'');\nif (typeof c.apply_changes !== 'boolean') throw new Error('apply_changes must be a boolean.');\nif (c.stage_attribute && !/^[a-z0-9_]+$/.test(c.stage_attribute)) throw new Error('Use the Attio attribute API slug for stage_attribute.');\nreturn [{json:c}];"
      },
      "id": "node-3",
      "name": "Validate setup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.signals_base_url + '/v1/signal' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({domain:$json.domain}) }}",
        "options": {
          "timeout": 400000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        }
      },
      "id": "node-4",
      "name": "Analyze website",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "notes": "Select your Signals Header Auth credential here. See QUICKSTART.md.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "const r=$input.first().json;\nif (r.coverage!=='complete' || !r.website_activity_stage || r.domain!==$('Validate setup').first().json.domain) throw new Error('Incomplete or mismatched analysis; do not update the CRM.');\nreturn [{json:r}];"
      },
      "id": "node-5",
      "name": "Preview signal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "apply-enabled",
              "leftValue": "={{ $('Validate setup').first().json.apply_changes }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-6",
      "name": "Apply changes?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{json:{applied:false,message:'Preview only. Review the signal, then set apply_changes to true in Setup.',signal:$('Preview signal').first().json}}];"
      },
      "id": "node-7",
      "name": "Preview only",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.attio.com/v2/objects/companies/records/query",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({filter:{domains:{domain:{$eq:$('Preview signal').first().json.domain}}},limit:2}) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        }
      },
      "id": "node-8",
      "name": "Find company",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        300
      ],
      "notes": "Select your Attio Header Auth credential here. See QUICKSTART.md.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "const records=$input.first().json.data;\nconst signal=$('Preview signal').first().json;\nif(!Array.isArray(records) || records.length!==1) throw new Error('Expected exactly one existing Attio company for this domain. Resolve the match in Attio and retry.');\nconst record=records[0];\nconst domains=(record.values?.domains ?? []).map(v=>String(v.domain ?? '').toLowerCase().replace(/^www\\./,'').replace(/\\.$/,''));\nif(!domains.includes(signal.domain)) throw new Error('Matched company domain does not equal the analyzed domain.');\nconst recordId=record.id?.record_id;\nif(!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(recordId ?? '')) throw new Error('Missing valid Attio company record ID.');\nreturn [{json:{...signal,recordId}}];"
      },
      "id": "node-9",
      "name": "Resolve company",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.attio.com/v2/notes",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
                    "type": "qs",
                    "name": "offset",
                    "value": "={{ $pageCount * 50 }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ $response.body.data.length < 50 }}",
              "limitPagesFetched": true,
              "maxRequests": 40,
              "requestInterval": 150
            }
          }
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "parent_object",
              "value": "companies"
            },
            {
              "name": "parent_record_id",
              "value": "={{ $json.recordId }}"
            },
            {
              "name": "limit",
              "value": "50"
            }
          ]
        }
      },
      "id": "node-10",
      "name": "Find managed note",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2160,
        300
      ],
      "notes": "Select your Attio Header Auth credential here. See QUICKSTART.md.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "const r=$('Resolve company').first().json;\nconst config=$('Validate setup').first().json;\nconst pages=$input.all().map(i=>i.json);\nif(!pages.length || pages.some(p=>!Array.isArray(p.data)) || pages.at(-1).data.length>=50) throw new Error('Note lookup incomplete. Stop before writing; check pagination.');\nconst matches=pages.flatMap(p=>p.data).filter(n=>n.title===r.note_title);\nif(matches.length>1) throw new Error('Multiple matching notes. Resolve duplicates in Attio before retrying.');\nconst existing=matches[0];\nif(existing && !(existing.content_plaintext ?? existing.content_markdown ?? '').includes('Managed by Website History Signals')) throw new Error('The matching note is not managed by this starter. Rename it before continuing.');\nconst noteId=existing?.id?.note_id;\nif(existing && !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(noteId ?? '')) throw new Error('Missing valid note ID.');\nconst note={title:r.note_title,format:'markdown',content:r.note_markdown};\nreturn [{json:{recordId:r.recordId,recordBody:{data:{values:{[config.stage_attribute]:[r.website_activity_stage]}}},noteMethod:existing?'PATCH':'POST',noteUrl:'https://api.attio.com/v2/notes'+(existing?'/'+encodeURIComponent(noteId):''),noteBody:{data:existing?note:{parent_object:'companies',parent_record_id:r.recordId,...note}}}}];"
      },
      "id": "node-11",
      "name": "Prepare Attio write",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        300
      ]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "={{ 'https://api.attio.com/v2/objects/companies/records/' + $json.recordId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.recordBody) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        }
      },
      "id": "node-12",
      "name": "Update website stage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2640,
        300
      ],
      "notes": "Select your Attio Header Auth credential here. See QUICKSTART.md.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "={{ $('Prepare Attio write').first().json.noteMethod }}",
        "url": "={{ $('Prepare Attio write').first().json.noteUrl }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Prepare Attio write').first().json.noteBody) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        }
      },
      "id": "node-13",
      "name": "Create or update note",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2880,
        300
      ],
      "notes": "Select your Attio Header Auth credential here. See QUICKSTART.md.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "return [{json:{applied:true,domain:$('Preview signal').first().json.domain,website_activity_state:$('Preview signal').first().json.website_activity_stage,note_action:$('Prepare Attio write').first().json.noteMethod==='POST'?'created':'updated'}}];"
      },
      "id": "node-14",
      "name": "Done",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3120,
        300
      ]
    },
    {
      "parameters": {
        "content": "## Start here\n1. Read QUICKSTART.md and docs/n8n.md.\n2. Set the domain and service URL in Setup.\n3. Connect the named Header Auth credentials to HTTP nodes.\n4. Keep apply_changes false for a preview.\n\nRun ONE company per execution. Use a batch-size-one loop for lists.\nNo credentials or customer data are included.\nAn analysis service is required; this workflow is an adapter.",
        "height": 320,
        "width": 450
      },
      "id": "node-15",
      "name": "Read me first",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -100
      ]
    }
