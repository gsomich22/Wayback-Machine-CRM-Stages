# Copy to .env, then use node --env-file=.env src/server.mjs.
# npm start alone reads exported environment variables; it does not auto-load this file.
# Never share .env. n8n CRM tokens belong in n8n credentials instead.
ATTIO_API_TOKEN=
APOLLO_API_KEY=
SIGNALS_API_TOKEN=
PORT=8787
HOST=127.0.0.1
# Optional server tuning for both HTTP routes (defaults shown).
SIGNALS_MAX_PAGES=15
SIGNALS_PAGE_SIZE=15000
SIGNALS_TIMEOUT_SECONDS=360
SIGNALS_MAX_CONCURRENT=2
